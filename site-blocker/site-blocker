def setup_nm_dnsmasq() -> None:
    resolv = Path("/etc/resolv.conf")
    already = (
        NM_CONF.exists()
        and resolv.is_symlink()
        and os.readlink(resolv) == "/run/NetworkManager/resolv.conf"
        and subprocess.run(
            ["systemctl", "is-active", "--quiet", "systemd-resolved"]
        ).returncode
        != 0
    )
    if already:
        print(f"  NetworkManager dnsmasq: already configured")
        return

    NM_CONF.parent.mkdir(parents=True, exist_ok=True)
    NM_CONF.write_text("[main]\ndns=dnsmasq\n", encoding="utf-8")
    print(f"  NetworkManager dnsmasq: {NM_CONF}")

    if resolv.is_symlink() and "systemd" in os.readlink(resolv):
        resolv.unlink()
    elif resolv.exists() and not resolv.is_symlink():
        shutil.copy2(resolv, "/etc/resolv.conf.site-blocker-backup")
        resolv.unlink()
    target = Path("/run/NetworkManager/resolv.conf")
    if not resolv.exists():
        resolv.symlink_to(target)

    subprocess.run(["systemctl", "disable", "--now", "systemd-resolved"], check=False)
    subprocess.run(["systemctl", "restart", "NetworkManager"], check=False)
    print("  systemd-resolved disabled; NetworkManager now answers DNS")


def reload_dns(gentle: bool = False) -> None:
    if gentle:
        # Restart just the DNS plugin so dnsmasq re-reads dnsmasq.d. Falls back
        # to a full NetworkManager restart if nmcli lacks the flag.
        res = subprocess.run(
            ["nmcli", "general", "reload", "dns-full"],
            capture_output=True,
            check=False,
        )
        if res.returncode == 0:
            return
    subprocess.run(["systemctl", "restart", "NetworkManager"], check=False)


LOG_FILE = STATE_DIR / "site-blocker.log"


def log_event(message: str) -> None:
    """Record state changes so timer-driven runs can be debugged later."""
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with LOG_FILE.open("a", encoding="utf-8") as fh:
            fh.write(time.strftime("%Y-%m-%d %H:%M:%S ") + message + "\n")
        if LOG_FILE.stat().st_size > 64 * 1024:
            lines = LOG_FILE.read_text(encoding="utf-8").splitlines()[-200:]
            LOG_FILE.write_text("\n".join(lines) + "\n", encoding="utf-8")
    except OSError:
        pass


def dns_is_blocked(domain: str, timeout: float = 2.0) -> bool | None:
    """Query the local resolver directly; True if it answers NXDOMAIN.

    Bypasses nsswitch caching so it reports what dnsmasq currently serves.
    """
    qname = b"".join(bytes([len(p)]) + p.encode() for p in domain.split(".")) + b"\x00"
    packet = b"\x00\x01\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00" + qname + b"\x00\x01\x00\x01"
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.settimeout(timeout)
        sock.sendto(packet, ("127.0.0.1", 53))
        reply, _ = sock.recvfrom(2048)
    except OSError:
        return None
    finally:
        sock.close()
    if len(reply) < 12:
        return None
    return (reply[3] & 0x0F) == 3


def wait_dns(blocked: bool, domain: str, timeout: float) -> bool:
    deadline = time.monotonic() + timeout
    while True:
        if dns_is_blocked(domain) == blocked:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)


def apply_dns(blocked: bool, domain: str) -> None:
    """Make the resolver serve the requested state, then prove it did.

    `nmcli general reload dns-full` usually restarts dnsmasq, but a run from a
    transient systemd unit can return success without the child picking up a
    changed conf-dir. Verify with a direct query and restart NetworkManager
    when the gentle path did not take effect.
    """
    if dns_is_blocked(domain) == blocked:
        return
    reload_dns(gentle=True)
    if wait_dns(blocked, domain, 3.0):
        log_event(f"dns reloaded: {domain} {'blocked' if blocked else 'allowed'}")
        return
    log_event(f"gentle reload failed for {domain}; restarting NetworkManager")
    subprocess.run(["systemctl", "restart", "NetworkManager"], check=False)
    if wait_dns(blocked, domain, 20.0):
        log_event(f"dns after NetworkManager restart: {domain} {'blocked' if blocked else 'allowed'}")
    else:
        log_event(f"warning: dns state still wrong for {domain}")


def read_pause() -> int | None:
    """Epoch seconds until which blocking is lifted, or None."""
    try:
        data = json.loads(PAUSE_JSON.read_text(encoding="utf-8"))
        until = int(data.get("until", 0))
    except (OSError, ValueError, TypeError):
        return None
    return until if until > 0 else None


def pause_active() -> bool:
    until = read_pause()
    return PAUSED_CONF.exists() and until is not None and until > int(time.time())


def write_pause_json(until: int, started: int) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = PAUSE_JSON.with_suffix(".json.tmp")
    tmp.write_text(
        json.dumps({"until": until, "started": started}) + "\n", encoding="utf-8"
    )
    os.chmod(tmp, 0o644)
    os.replace(tmp, PAUSE_JSON)


def cancel_resume_timer() -> None:
    timer = f"{RESUME_UNIT}.timer"
    service = f"{RESUME_UNIT}.service"
    # Never stop the service: a timer-fired run calls this from inside that
    # very service, and stopping it would kill the command mid-way through.
    subprocess.run(["systemctl", "stop", timer], capture_output=True, check=False)
    subprocess.run(["systemctl", "reset-failed", timer, service], capture_output=True, check=False)


def schedule_resume(seconds: int) -> bool:
    """Arrange for `site-blocker resume` to run when the window elapses."""
    cancel_resume_timer()
    res = subprocess.run(
        [
            "systemd-run",
            "--unit", RESUME_UNIT,
            "--collect",
            "--timer-property=AccuracySec=1s",
            f"--on-active={max(1, int(seconds))}",
            str(SELF), "resume",
        ],
        capture_output=True,
        text=True,
    )
    if res.returncode != 0:
        print(
            "site-blocker: warning: could not schedule auto-resume: "
            + (res.stderr.strip() or f"exit {res.returncode}"),
            file=sys.stderr,
        )
        return False
    return True


def pause_cleanup() -> None:
    try:
        PAUSE_JSON.unlink()
    except FileNotFoundError:
        pass
    cancel_resume_timer()


def restore_conf() -> None:
    """Move the parked blocklist back into dnsmasq.d and clear pause state."""
    CONF.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(PAUSED_CONF), str(CONF))
    try:
        CONF.chmod(0o644)
    except OSError:
        pass
    pause_cleanup()


def heal_expired_pause() -> bool:
    """Restore the blocklist if its pause window has elapsed (missed timer)."""
    if not PAUSED_CONF.exists():
        return False
    until = read_pause()
    if until is not None and until > int(time.time()):
        return False
    restore_conf()
    return True


def test_resolution() -> None:
    print("\n  resolution check:")

    def lookup(domain: str) -> str:
        try:
            res = subprocess.run(
                ["getent", "ahosts", domain],
                capture_output=True,
                text=True,
                timeout=8,
            )
        except subprocess.TimeoutExpired:
            return "TIMEOUT"
        if res.returncode != 0 or not res.stdout.strip():
            return "blocked"
        first = res.stdout.splitlines()[0].split()[0]
        if first in ("0.0.0.0", "::"):
            return "blocked"
        return "ok"

    for d in (
        "instagram.com",
        "www.facebook.com",
        "poki.com",
        "youtube.com",
        "discord.com",
        "whatsapp.com",
        "www.pw.live",
        "google.com",
    ):
        print(f"    {d:<22} {lookup(d)}")


def cmd_update(args: argparse.Namespace) -> None:
