def cmd_uninstall(_: argparse.Namespace) -> None:
    need_root()
    print("Removing site-blocker ...")
    subprocess.run(["systemctl", "disable", "--now", TIMER.name], check=False)
    cancel_resume_timer()
    for p in (
        TIMER,
        SERVICE,
        NM_CONF,
        CONF,
        PAUSED_CONF,
        PAUSE_JSON,
        SAFESEARCH_CONF,
        PACMAN_HOOK,
        FIREFOX_POLICY,
    ):
        try:
            p.unlink()
            print(f"  removed {p}")
        except FileNotFoundError:
            pass

    # Remove our DoH policy from the packaged Zen file, keep other policies.
    if ZEN_POLICY.exists():
        try:
            data = json.loads(ZEN_POLICY.read_text(encoding="utf-8"))
            data.get("policies", {}).pop("DNSOverHTTPS", None)
            ZEN_POLICY.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
            print(f"  cleaned {ZEN_POLICY}")
        except (ValueError, OSError):
            pass

    subprocess.run(["systemctl", "daemon-reload"], check=False)
    subprocess.run(["systemctl", "unmask", "systemd-resolved.service"], check=False)
    subprocess.run(
        [
            "systemctl",
            "enable",
            "--now",
            "systemd-resolved.service",
            "systemd-resolved-monitor.socket",
            "systemd-resolved-varlink.socket",
        ],
        check=False,
    )
    resolv = Path("/etc/resolv.conf")
    try:
        resolv.unlink()
    except FileNotFoundError:
        pass
    backup = Path("/etc/resolv.conf.site-blocker-backup")
    if backup.exists():
        shutil.move(str(backup), resolv)
    else:
        resolv.symlink_to("/run/systemd/resolve/stub-resolv.conf")
    subprocess.run(["systemctl", "restart", "NetworkManager"], check=False)
    print("Done. DNS restored to systemd-resolved.")
    print(f"Left in place: {ALLOW_FILE}, {EXTRA_FILE}, {STATE_DIR}, {SELF}")


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="site-blocker", description="System-wide DNS distraction blocker"
    )
    sub = parser.add_subparsers(dest="cmd")

    p = sub.add_parser("update", help="download lists, rebuild, reload DNS")
    p.add_argument("--no-reload", action="store_true")
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("apply", help="rebuild from cached lists")
    p.add_argument("--no-reload", action="store_true")
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("pause", help="lift blocking for N minutes (default 120)")
    p.add_argument("minutes", nargs="?", type=int, default=PAUSE_DEFAULT_MIN)
    p.set_defaults(func=cmd_pause)

    p = sub.add_parser("resume", help="restore blocking now")
    p.set_defaults(func=cmd_resume)

    p = sub.add_parser("paused", help="show pause state")
    p.set_defaults(func=cmd_paused)

    p = sub.add_parser("heal", help="restore expired allow windows (boot watchdog)")
    p.set_defaults(func=cmd_heal)

    p = sub.add_parser("doh", help="(re)apply browser DoH lock")
    p.set_defaults(func=cmd_doh)

    p = sub.add_parser("status", help="show status and test domains")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("allow", help="allow domains")
    p.add_argument("domains", nargs="+")
    p.set_defaults(func=cmd_allow)

    p = sub.add_parser("block", help="block extra domains")
    p.add_argument("domains", nargs="+")
    p.set_defaults(func=cmd_block)

    p = sub.add_parser("uninstall", help="remove and restore DNS")
    p.set_defaults(func=cmd_uninstall)

    parser.set_defaults(func=cmd_update)
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
