    if not args.no_reload:
        reload_dns()
    print("\nDone.")


def cmd_doh(_: argparse.Namespace) -> None:
    need_root()
    write_doh_policies()


def cmd_pause(args: argparse.Namespace) -> None:
    need_root()
    minutes = max(1, min(PAUSE_MAX_MIN, int(args.minutes)))
    now = int(time.time())
    until = now + minutes * 60

    already_paused = pause_active()
    if CONF.exists():
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        shutil.move(str(CONF), str(PAUSED_CONF))
    if not PAUSED_CONF.exists():
        die("no blocklist to park (run: sudo site-blocker update)")

    write_pause_json(until, now)
    schedule_resume(max(1, until - now))
    if not already_paused:
        apply_dns(False, "instagram.com")
    until_text = time.strftime("%H:%M", time.localtime(until))
    print(
        f"site blocking lifted for {minutes} min (until {until_text})"
        + ("  [extended]" if already_paused else "")
    )


def cmd_resume(_: argparse.Namespace) -> None:
    need_root()
    if PAUSED_CONF.exists():
        restore_conf()
        apply_dns(True, "instagram.com")
        print("site blocking resumed")
    else:
        pause_cleanup()
        print("site blocking was not paused")


def cmd_paused(_: argparse.Namespace) -> None:
    until = read_pause()
    now = int(time.time())
    if PAUSED_CONF.exists() and until and until > now:
        until_text = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(until))
        print(f"paused until {until_text} ({max(0, until - now) // 60} min remaining)")
    elif PAUSED_CONF.exists():
        print("paused (window elapsed; restores on next apply, update or resume)")
    else:
        print("active")



def cmd_heal(_: argparse.Namespace) -> None:
    """Repair an expired reward pause left by a reboot or a missed timer."""
    need_root()
    healed = []
    if heal_expired_pause():
        apply_dns(True, "instagram.com")
        log_event("healed expired site-blocker pause window")
        healed.append("site blocking")
    if healed:
        print("Restored: " + ", ".join(healed))
    else:
        print("No expired allow windows")


def cmd_status(_: argparse.Namespace) -> None:
    live = CONF if CONF.exists() else PAUSED_CONF
    if not live.exists():
        die("not installed (no blocklist config found)")
    count = 0
    with live.open(encoding="utf-8", errors="ignore") as fh:
        for line in fh:
            if line.startswith("local=/"):
                count += 1
    mtime = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(live.stat().st_mtime))
    print(f"Blocked domains : {count:,}")
    print(f"List generated  : {mtime}")
    print(f"Config file     : {live}")
    print(f"Allow list      : {ALLOW_FILE} ({len(read_lines(ALLOW_FILE))} entries)")
    print(f"Extra blocklist : {EXTRA_FILE} ({len(read_lines(EXTRA_FILE))} entries)")
    try:
        print(f"resolv.conf     : {os.readlink('/etc/resolv.conf')}")
    except OSError:
        print("resolv.conf     : regular file")
    print(f"systemd-resolved: {subprocess.run(['systemctl', 'is-active', 'systemd-resolved'], capture_output=True, text=True).stdout.strip()}")
    print(f"timer           : {subprocess.run(['systemctl', 'is-active', 'site-blocker.timer'], capture_output=True, text=True).stdout.strip()}")
    until = read_pause()
    if PAUSED_CONF.exists():
        if until and until > int(time.time()):
            print(f"pause           : lifted until {time.strftime('%Y-%m-%d %H:%M', time.localtime(until))}")
        else:
            print("pause           : conf parked (window elapsed)")
    else:
        print("pause           : not paused")
    test_resolution()


def cmd_allow(args: argparse.Namespace) -> None:
    need_root()
    ensure_defaults()
    additions = []
    for raw in args.domains:
        d = raw.strip().lower().lstrip("*.").rstrip(".")
        if not valid_domain(d):
            die(f"invalid domain: {raw}")
        additions.append(d)
    with ALLOW_FILE.open("a", encoding="utf-8") as fh:
        if ALLOW_FILE.stat().st_size and not ALLOW_FILE.read_text(encoding="utf-8").endswith("\n"):
            fh.write("\n")
        fh.write(f"\n# added {time.strftime('%Y-%m-%d')}\n")
        for d in additions:
            fh.write(d + "\n")
    print(f"Allowed: {', '.join(additions)}")
    cmd_apply(argparse.Namespace(no_reload=False))


def cmd_block(args: argparse.Namespace) -> None:
    need_root()
    ensure_defaults()
    additions = []
    for raw in args.domains:
        d = raw.strip().lower().lstrip("*.").rstrip(".")
